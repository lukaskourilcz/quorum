{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "social-distribution-baseline/1"
    },
    "id": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^social-distribution-baseline-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "startsOn": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "endsOn": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "elapsedDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "status": {
      "type": "string",
      "enum": [
        "collecting",
        "complete"
      ]
    },
    "observationRefs": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "attributionRefs": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "acceptedObservationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "droppedObservationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "metricsAvailable": {
      "type": "boolean"
    },
    "ownerDecisionRequired": {
      "type": "boolean",
      "const": true
    },
    "authorityGranted": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "startsOn",
    "endsOn",
    "evaluatedAt",
    "elapsedDays",
    "status",
    "observationRefs",
    "attributionRefs",
    "acceptedObservationCount",
    "droppedObservationCount",
    "metricsAvailable",
    "ownerDecisionRequired",
    "authorityGranted"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/social-distribution-baseline.schema.json"
}
