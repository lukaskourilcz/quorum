  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "book-kb-index/1"
    },
    "ventureId": {
      "type": "string",
      "const": "door-money"
    },
    "ingestionId": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "manuscriptHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "manuscriptBytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "modelVersions": {
      "type": "object",
      "properties": {
        "annotation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "rollup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "embedding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "annotation",
        "rollup",
        "embedding"
      ],
      "additionalProperties": false
    },
    "ingestionCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "chunkCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "chapters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ch\\d{2,}$"
          },
          "ordinal": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "chunkIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ch\\d{2,}-s\\d{2,}-c\\d{3,}$"
            }
          }
        },
        "required": [
          "id",
          "ordinal",
          "summary",
          "chunkIds"
        ],
        "additionalProperties": false
      }
    },
    "entityIndex": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "person",
              "venue",
              "event",
              "organization",
              "other"
            ]
          },
          "personSensitive": {
            "type": "boolean"
          },
          "chunkIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ch\\d{2,}-s\\d{2,}-c\\d{3,}$"
            }
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "personSensitive",
          "chunkIds"
        ],
        "additionalProperties": false
      }
    },
    "themeIndex": {
      "type": "array",
