{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "odds-snapshot/1"
    },
    "boutRef": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "t3",
        "t1",
        "closing"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "odds-api",
        "owner-entry"
      ]
    },
    "market": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "prices": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pick": {
            "type": "string",
            "minLength": 1
          },
          "decimal": {
            "type": "number",
            "exclusiveMinimum": 1
          }
        },
        "required": [
          "pick",
          "decimal"
        ],
        "additionalProperties": {}
      }
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "boutRef",
    "phase",
    "source",
    "market",
    "prices",
    "capturedAt"
  ],
  "additionalProperties": {},
  "$id": "https://boardless.ai/contracts/odds-snapshot.schema.json"
}
