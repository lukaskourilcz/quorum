{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "personal-growth-publications/1"
    },
    "ventureId": {
      "type": "string",
      "const": "personal-growth"
    },
    "ownerAuthored": {
      "type": "boolean",
      "const": true
    },
    "recordedAt": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "sourceUrl": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https:\\/\\/"
    },
    "promotion": {
      "type": "object",
      "properties": {
        "anchorDate": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "everyNthDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": [
        "anchorDate",
        "everyNthDay"
      ],
      "additionalProperties": false
    },
    "publications": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "book",
              "audiobook"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "language": {
            "type": "string",
            "enum": [
              "cs",
              "en"
            ]
          },
          "pillar": {
            "type": "string",
            "enum": [
              "rapovej-denik",
              "writing-publishing",
              "books-reading",
              "hip-hop"
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^https:\\/\\/"
          },
          "sampleUrl": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "pattern": "^https:\\/\\/"
              },
              {
                "type": "null"
              }
            ]
          },
          "priceCzk": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "narrator": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "lengthHours": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "chapters": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "coverImageUrls": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500,
              "pattern": "^https:\\/\\/"
            }
          },
          "facts": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "author",
          "publisher",
          "language",
          "pillar",
          "url",
          "sampleUrl",
          "priceCzk",
          "narrator",
          "lengthHours",
          "chapters",
          "coverImageUrls",
          "facts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "ventureId",
    "ownerAuthored",
    "recordedAt",
    "sourceUrl",
    "promotion",
    "publications"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/personal-growth-publications.schema.json"
}
