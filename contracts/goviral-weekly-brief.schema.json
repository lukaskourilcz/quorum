{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "goviral-weekly-brief/1"
    },
    "ventureId": {
      "type": "string",
      "const": "goviral"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "planRef": {
      "type": "string",
      "pattern": "^state\\/ventures\\/goviral\\/plans\\/plan-\\d{4}-\\d{2}-\\d{2}-weekly-brief\\.json$"
    },
    "wordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "readingTimeMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "sections": {
      "minItems": 8,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "problem",
              "solution",
              "players",
              "predictions",
              "opportunities",
              "key-lessons",
              "haters",
              "links"
            ]
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "lines": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          }
        },
        "required": [
          "key",
          "heading",
          "lines"
        ],
        "additionalProperties": false
      }
    },
    "opportunities": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GV-\\d{4}-\\d{2}-\\d{2}-O[1-9]$"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "evidenceRefs": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        },
        "required": [
          "id",
          "number",
          "title",
          "detail",
          "evidenceRefs"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved"
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "ventureId",
    "date",
    "title",
    "planRef",
    "wordCount",
    "readingTimeMinutes",
    "sections",
    "opportunities",
    "status",
    "generatedAt"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/goviral-weekly-brief.schema.json"
}
