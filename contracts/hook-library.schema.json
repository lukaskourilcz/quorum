{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "hook-library/1"
    },
    "surface": {
      "type": "string",
      "const": "quiz"
    },
    "targetRepository": {
      "type": "string",
      "const": "lukaskourilcz/react-express-app"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "hookCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "libraryHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "vectorsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lint": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "number",
          "const": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "warningRules": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "errors",
        "warnings",
        "warningRules"
      ],
      "additionalProperties": {}
    },
    "files": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "enum": [
              "lib/hooks/quiz.hooks.json",
              "lib/hooks/hooks.predicates.spec.json"
            ]
          },
          "contents": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "contents",
          "sha256"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schemaVersion",
    "surface",
    "targetRepository",
    "generatedAt",
    "hookCount",
    "libraryHash",
    "vectorsHash",
    "idempotencyKey",
    "lint",
    "files"
  ],
  "additionalProperties": {},
  "$id": "https://boardless.ai/contracts/hook-library.schema.json"
}
