{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "kvorum-apify-quota/1"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "shareCapUsd": {
      "type": "number",
      "const": 2
    },
    "estimatedUsedUsd": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "sharedAccountUsedUsd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "reservedPerRun": {
      "type": "number",
      "const": 0.151
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "perActorCounts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "runs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "estimatedUsd": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "runs",
          "items",
          "estimatedUsd"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "month",
    "shareCapUsd",
    "estimatedUsedUsd",
    "sharedAccountUsedUsd",
    "reservedPerRun",
    "updatedAt",
    "perActorCounts"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/kvorum-apify-quota.schema.json"
}
