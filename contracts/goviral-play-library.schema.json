{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "goviral-play-library/1"
    },
    "ventureId": {
      "type": "string",
      "const": "goviral"
    },
    "reachScale": {
      "type": "string",
      "const": "reach-band/1"
    },
    "updatedAt": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "plays": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^play-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "category": {
            "type": "string",
            "enum": [
              "hook",
              "format",
              "distribution",
              "search",
              "community",
              "cadence",
              "conversion"
            ]
          },
          "ventureId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "readTimeMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "reach": {
            "type": "object",
            "properties": {
              "band": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "basis": {
                "type": "string",
                "enum": [
                  "measured",
                  "estimate"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "band",
              "basis",
              "note"
            ],
            "additionalProperties": false
          },
          "impact": {
            "anyOf": [
              {
                "type": "number",
                "const": 0.25
              },
              {
                "type": "number",
                "const": 0.5
              },
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              }
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "const": 0.5
              },
              {
                "type": "number",
                "const": 0.8
              },
              {
                "type": "number",
                "const": 1
              }
            ]
          },
          "effortPersonWeeks": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 52
          },
          "benchmark": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "metric": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "higher-is-better",
                      "lower-is-better"
                    ]
                  },
                  "baseline": {
                    "type": "number"
                  },
                  "achieved": {
                    "type": "number"
                  },
                  "measuredOver": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "sourceRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "required": [
                  "metric",
                  "unit",
                  "direction",
                  "baseline",
                  "achieved",
                  "measuredOver",
                  "sourceRef"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "screenshot": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^state\\/ventures\\/goviral\\/plays\\/screenshots\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:png|jpg|webp)$"
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "capturedAt": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "subject": {
                    "type": "string",
                    "enum": [
                      "own-surface",
                      "owner-supplied"
                    ]
                  },
                  "visibility": {
                    "type": "string",
                    "const": "admin-only"
                  }
                },
                "required": [
                  "path",
                  "alt",
                  "capturedAt",
                  "subject",
                  "visibility"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceRefs": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "recordedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "ventureId",
          "summary",
          "readTimeMinutes",
          "reach",
          "impact",
          "confidence",
          "effortPersonWeeks",
          "benchmark",
          "screenshot",
          "evidenceRefs",
          "recordedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "ventureId",
    "reachScale",
    "updatedAt",
    "plays"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/goviral-play-library.schema.json"
}
