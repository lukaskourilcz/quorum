{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "tehdejsi-facts/1"
    },
    "copiedFrom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "copiedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "facts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "everyday",
              "culture",
              "city",
              "price",
              "media",
              "event"
            ]
          },
          "country": {
            "type": "string",
            "enum": [
              "cz",
              "ua"
            ]
          },
          "place": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "yearFrom": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2030
          },
          "yearTo": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2030
          },
          "sensitivityTier": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              }
            ]
          },
          "shareSafe": {
            "type": "boolean",
            "const": true
          },
          "text": {
            "type": "string",
            "minLength": 20,
            "maxLength": 600
          },
          "sources": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 400
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "title",
                "url",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "verified": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "country",
          "place",
          "yearFrom",
          "yearTo",
          "sensitivityTier",
          "shareSafe",
          "text",
          "sources",
          "verified"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "copiedFrom",
    "copiedAt",
    "contentHash",
    "facts"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/tehdejsi-facts.schema.json"
}
