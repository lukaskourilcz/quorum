{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "editorial-decision/1"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "imageId": {
      "type": "string",
      "enum": [
        "photo-1",
        "photo-2",
        "fal",
        "candidate-1",
        "candidate-2",
        "candidate-3",
        "candidate-4"
      ]
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "actor": {
      "type": "string",
      "const": "owner"
    }
  },
  "required": [
    "schemaVersion",
    "reviewId",
    "reviewHash",
    "action",
    "title",
    "imageId",
    "decidedAt",
    "actor"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/editorial-decision.schema.json"
}
