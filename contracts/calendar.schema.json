{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "calendar/1"
    },
    "weekOf": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "tz": {
            "type": "string",
            "const": "Europe/Prague"
          },
          "kind": {
            "type": "string",
            "enum": [
              "venture-morning",
              "venture-afternoon",
              "venture-night",
              "cu-edition",
              "cu-product",
              "tt-marketing",
              "gv-brief",
              "ms-daily",
              "bh-desk",
              "dm-desk",
              "dm-growth",
              "ts-desk",
              "kv-desk",
              "incubator-scan",
              "incubator-synthesis",
              "mma-intake",
              "mma-analysis",
              "mag-editorial",
              "mag-desk",
              "article-am",
              "article-pm",
              "studio",
              "cu-day",
              "mma-day",
              "dm-day"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "held",
              "late",
              "missed",
              "not-needed",
              "skipped"
            ]
          },
          "meetingRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "decisionOneLiner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        },
        "required": [
          "at",
          "tz",
          "kind",
          "status"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schemaVersion",
    "weekOf",
    "slots"
  ],
  "additionalProperties": {},
  "$id": "https://boardless.ai/contracts/calendar.schema.json"
}
