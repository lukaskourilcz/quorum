{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "owner-manual-reference/1"
    },
    "referenceId": {
      "type": "string",
      "pattern": "^pg-manual-ref-[a-f0-9]{16}$"
    },
    "sourceProject": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "publicItemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^https:\\/\\/"
    },
    "ownerAuthored": {
      "type": "boolean"
    },
    "personalConnection": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 360
        },
        {
          "type": "null"
        }
      ]
    },
    "ownerCommentaryNote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "publicationVerifiedByOwner": {
      "type": "boolean",
      "const": true
    },
    "ownerManuallySupplied": {
      "type": "boolean",
      "const": true
    },
    "personalItemsInRollingWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ventureItemsInRollingWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requestedAction": {
      "type": "string",
      "enum": [
        "WATCH",
        "RESHARE_WITH_PERSONAL_NOTE",
        "SKIP"
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "ownerProvenanceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  },
  "required": [
    "schemaVersion",
    "referenceId",
    "sourceProject",
    "publicItemId",
    "publicUrl",
    "ownerAuthored",
    "personalConnection",
    "ownerCommentaryNote",
    "publicationVerifiedByOwner",
    "ownerManuallySupplied",
    "personalItemsInRollingWindow",
    "ventureItemsInRollingWindow",
    "requestedAction",
    "recordedAt",
    "expiresAt",
    "ownerProvenanceRef"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/personal-growth-manual-venture-reference.schema.json"
}
