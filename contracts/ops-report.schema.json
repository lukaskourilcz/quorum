{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "ops-report/1"
    },
    "period": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly"
      ]
    },
    "periodKey": {
      "type": "string",
      "pattern": "^\\d{4}-(?:W\\d{2}|\\d{2})$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "meetings": {
      "type": "object",
      "properties": {
        "scheduled": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "held": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "phase": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            },
            "required": [
              "date",
              "phase",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "missingDays": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        }
      },
      "required": [
        "scheduled",
        "held",
        "skipped",
        "missingDays"
      ],
      "additionalProperties": false
    },
    "spend": {
      "type": "object",
      "properties": {
        "periodUsd": {
          "type": "number",
          "minimum": 0
        },
        "mtdUsd": {
          "type": "number",
          "minimum": 0
        },
        "capUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "byVenture": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "required": [
        "periodUsd",
        "mtdUsd",
        "capUsd",
        "byVenture"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "published": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ventureId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "ventureId",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "scores": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "avg": {
                  "type": "number"
                },
                "worst": {
                  "type": "number"
                },
                "best": {
                  "type": "number"
                }
              },
              "required": [
                "avg",
                "worst",
                "best"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "published",
        "scores"
      ],
      "additionalProperties": false
    },
    "quality": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "vetoRate": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "firstPassRate": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "retryRate": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "vetoRate",
            "firstPassRate",
            "retryRate"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "kind",
          "date",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "fixTasks": {
      "type": "object",
      "properties": {
        "opened": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "closed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "opened",
        "closed"
      ],
      "additionalProperties": false
    },
    "perVenture": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ventureId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "verdictSummary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "outputs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "spendUsd": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "ventureId",
          "verdictSummary",
          "outputs",
          "spendUsd"
        ],
        "additionalProperties": false
      }
    },
    "narrative": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "period",
    "periodKey",
    "generatedAt",
    "meetings",
    "spend",
    "content",
    "quality",
    "incidents",
    "fixTasks",
    "perVenture",
    "narrative"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/ops-report.schema.json"
}
