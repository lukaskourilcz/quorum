{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "niche-proposal/1"
    },
    "id": {
      "type": "string",
      "pattern": "^niche-\\d{4}-\\d{2}-\\d{2}-[a-f0-9]{4,12}$"
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "oneLiner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "whyPeopleCareDaily": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "audienceHypothesis": {
      "type": "object",
      "properties": {
        "regions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "ageRange": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 18,
              "maximum": 120
            },
            "max": {
              "type": "integer",
              "minimum": 18,
              "maximum": 120
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": {}
        },
        "genders": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "women",
              "men",
              "nonbinary",
              "all"
            ]
          }
        },
        "interests": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "artificial-intelligence",
              "business",
              "culture",
              "design",
              "digital-media",
              "ecommerce",
              "entrepreneurship",
              "fashion",
              "news",
              "skateboarding",
              "startups",
              "streetwear",
              "technology",
              "womens-fashion"
            ],
            "description": "Interest-based public categories only. Never use personal data or custom audiences from data the company does not have."
          }
        },
        "platforms": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "instagram",
              "threads",
              "facebook",
              "tiktok",
              "youtube",
              "reddit",
              "web",
              "newsletter"
            ]
          }
        },
        "adTargetingNotes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      },
      "required": [
        "regions",
        "ageRange",
        "genders",
        "interests",
        "platforms",
        "adTargetingNotes"
      ],
      "additionalProperties": {}
    },
    "contentShape": {
      "type": "object",
      "properties": {
        "cadence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "formats": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "caughtUpReuseNotes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "cadence",
        "formats",
        "caughtUpReuseNotes"
      ],
      "additionalProperties": {}
    },
    "competitionNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "evidenceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "note",
          "evidenceRef"
        ],
        "additionalProperties": {}
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "rated",
        "shortlist",
        "archived"
      ]
    },
    "originMeetingRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "domain",
    "oneLiner",
    "whyPeopleCareDaily",
    "audienceHypothesis",
    "contentShape",
    "competitionNotes",
    "risks",
    "evidenceRefs",
    "status",
    "originMeetingRef"
  ],
  "additionalProperties": {},
  "$id": "https://boardless.ai/contracts/niche-proposal.schema.json"
}
