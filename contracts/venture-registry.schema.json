{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "venture-registry/1"
    },
    "ventures": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "exploration",
              "operating",
              "paused"
            ]
          },
          "taste": {
            "type": "boolean"
          },
          "ledgerNamespace": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "adminTabs": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ideas",
                "plans",
                "visuals",
                "niche-proposals"
              ]
            }
          },
          "meetings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "cadence": {
                  "type": "string",
                  "pattern": "^daily@(?:0[5-9]|1\\d|2[0-3]):00$"
                },
                "cast": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "VIZE",
                      "FORGE",
                      "PULSE",
                      "AUDIT",
                      "SCOUT",
                      "SCRIBE",
                      "LENS",
                      "QUILL",
                      "RADAR",
                      "KEEPER",
                      "THREADS",
                      "INSTAGRAM",
                      "PEOPLE",
                      "LEDGER",
                      "HERALD",
                      "STET",
                      "HACEK",
                      "SPARK",
                      "VAULT",
                      "FRAME",
                      "RELAY",
                      "ANGLE",
                      "COHORT",
                      "FUNNEL",
                      "PALATE",
                      "SCENE",
                      "STUNT"
                    ]
                  }
                },
                "envelopeUsd": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "packet": {
                  "type": "object",
                  "properties": {
                    "topicType": {
                      "type": "string",
                      "enum": [
                        "growth",
                        "build",
                        "evidence",
                        "finance",
                        "social",
                        "org",
                        "incident",
                        "council",
                        "edition",
                        "product"
                      ]
                    },
                    "decisionNeeded": {
                      "type": "string",
                      "enum": [
                        "PLAN",
                        "NO_ACTION",
                        "VERDICT",
                        "MEMO",
                        "EDITION",
                        "IDEA_VERDICT"
                      ]
                    },
                    "preset": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "objectives": {
                      "type": "object",
                      "properties": {
                        "dry": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 400
                        },
                        "live": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 400
                        }
                      },
                      "required": [
                        "dry",
                        "live"
                      ],
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "topicType",
                    "decisionNeeded",
                    "preset",
                    "objectives"
                  ],
                  "additionalProperties": {}
                }
              },
              "required": [
                "kind",
                "label",
                "cadence",
                "cast",
                "envelopeUsd",
                "packet"
              ],
              "additionalProperties": {}
            }
          },
          "pendingApproval": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "taste",
          "ledgerNamespace",
          "adminTabs",
          "meetings"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schemaVersion",
    "ventures"
  ],
  "additionalProperties": {},
  "$id": "https://boardless.ai/contracts/venture-registry.schema.json"
}
