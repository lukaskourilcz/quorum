{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "venture-registry/1"
    },
    "ventures": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "exploration",
              "operating",
              "paused"
            ]
          },
          "taste": {
            "type": "boolean"
          },
          "ledgerNamespace": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "growth_objective": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "components": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "edition-cadence",
                    "source-coverage",
                    "slot-fill",
                    "rendered-fightaiq-coverage",
                    "event-fighter-coverage",
                    "two-source-agreement",
                    "readiness-dossiers",
                    "campaign-inventory",
                    "evidence-backed-proposals"
                  ]
                }
              }
            },
            "required": [
              "label",
              "components"
            ],
            "additionalProperties": {}
          },
          "mode": {
            "type": "string",
            "enum": [
              "data-only",
              "live-analysis"
            ]
          },
          "adminTabs": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ideas",
                "plans",
                "visuals",
                "niche-proposals",
                "fighters",
                "events",
                "slates",
                "sources",
                "articles",
                "calendar",
                "social-lab"
              ]
            }
          },
          "productionJobs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "cadence": {
                  "type": "string",
                  "pattern": "^(?:2x-daily@\\d{2}:00,\\d{2}:00|daily@(?:0[5-9]|1\\d|2[0-3]):00)$"
                },
                "envelopeUsd": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "kind",
                "cadence",
                "envelopeUsd"
              ],
              "additionalProperties": {}
            }
          },
          "templateOperation": {
            "type": "object",
            "properties": {
              "templateId": {
                "type": "string",
                "const": "content-venture-default"
              },
              "deliveryTarget": {
                "type": "string",
                "enum": [
                  "boardless-site",
                  "caught-up",
                  "mma-files"
                ]
              },
              "dailyEnvelopeUsd": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 0.15
              },
              "cast": {
                "minItems": 2,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "VIZE",
                    "FORGE",
                    "PULSE",
                    "AUDIT",
                    "SCOUT",
                    "SCRIBE",
                    "LENS",
                    "QUILL",
                    "RADAR",
                    "KEEPER",
                    "THREADS",
                    "INSTAGRAM",
                    "PEOPLE",
                    "LEDGER",
                    "HERALD",
                    "STET",
                    "HACEK",
                    "SPARK",
                    "VAULT",
                    "FRAME",
                    "RELAY",
                    "ANGLE",
                    "COHORT",
                    "FUNNEL",
                    "PALATE",
                    "SCENE",
                    "STUNT",
                    "CORNER",
                    "SPOTTER",
                    "TAPE",
                    "SIGMA",
                    "VIG",
                    "SONAR",
                    "CANVAS",
                    "JAB",
                    "REACH",
                    "SPLIT",
                    "PIVOT"
                  ]
                }
              },
              "cadence": {
                "type": "string",
                "pattern": "^agenda-gated@(?:0[5-9]|1\\d|2[0-3]):00$"
              },
              "proposalRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "templateId",
              "deliveryTarget",
              "dailyEnvelopeUsd",
              "cast",
              "cadence",
              "proposalRef"
            ],
            "additionalProperties": {}
          },
          "meetings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "cadence": {
                  "type": "string",
                  "pattern": "^daily@(?:0[5-9]|1\\d|2[0-3]):00$"
                },
                "cast": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "VIZE",
                      "FORGE",
                      "PULSE",
                      "AUDIT",
                      "SCOUT",
                      "SCRIBE",
                      "LENS",
                      "QUILL",
                      "RADAR",
                      "KEEPER",
                      "THREADS",
                      "INSTAGRAM",
                      "PEOPLE",
                      "LEDGER",
                      "HERALD",
                      "STET",
                      "HACEK",
                      "SPARK",
                      "VAULT",
                      "FRAME",
                      "RELAY",
                      "ANGLE",
                      "COHORT",
                      "FUNNEL",
                      "PALATE",
                      "SCENE",
                      "STUNT",
                      "CORNER",
                      "SPOTTER",
                      "TAPE",
                      "SIGMA",
                      "VIG",
                      "SONAR",
                      "CANVAS",
                      "JAB",
                      "REACH",
                      "SPLIT",
                      "PIVOT"
                    ]
                  }
                },
                "envelopeUsd": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "packet": {
                  "type": "object",
                  "properties": {
                    "topicType": {
                      "type": "string",
                      "enum": [
                        "growth",
                        "build",
                        "evidence",
                        "finance",
                        "social",
                        "org",
                        "incident",
                        "council",
                        "edition",
                        "product"
                      ]
                    },
                    "decisionNeeded": {
                      "type": "string",
                      "enum": [
                        "PLAN",
                        "NO_ACTION",
                        "VERDICT",
                        "MEMO",
                        "EDITION",
                        "IDEA_VERDICT"
                      ]
                    },
                    "preset": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "objectives": {
                      "type": "object",
                      "properties": {
                        "dry": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 400
                        },
                        "live": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 400
                        }
                      },
                      "required": [
                        "dry",
                        "live"
                      ],
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "topicType",
                    "decisionNeeded",
                    "preset",
                    "objectives"
                  ],
                  "additionalProperties": {}
                }
              },
              "required": [
                "kind",
                "label",
                "cadence",
                "cast",
                "envelopeUsd",
                "packet"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "taste",
          "ledgerNamespace",
          "growth_objective",
          "adminTabs",
          "meetings"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schemaVersion",
    "ventures"
  ],
  "additionalProperties": {},
  "$id": "https://boardless.ai/contracts/venture-registry.schema.json"
}
