{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "venture-registry/1"
    },
    "ventures": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "exploration",
              "operating",
              "paused"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "owner-only"
            ]
          },
          "taste": {
            "type": "boolean"
          },
          "ledgerNamespace": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "delivery": {
            "type": "object",
            "properties": {
              "product": {
                "type": "string",
                "const": "social-first"
              },
              "website": {
                "type": "string",
                "const": "absent"
              }
            },
            "required": [
              "product",
              "website"
            ],
            "additionalProperties": false
          },
          "editions": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "locale": {
                  "type": "string",
                  "enum": [
                    "cs",
                    "en"
                  ]
                },
                "profileRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "held",
                    "draft",
                    "operating"
                  ]
                }
              },
              "required": [
                "id",
                "locale",
                "profileRef",
                "state"
              ],
              "additionalProperties": false
            }
          },
          "growth_objective": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "components": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "edition-cadence",
                    "source-coverage",
                    "slot-fill",
                    "rendered-fightaiq-coverage",
                    "event-fighter-coverage",
                    "two-source-agreement",
                    "readiness-dossiers",
                    "campaign-inventory",
                    "live-template-library",
                    "package-cadence",
                    "recommendation-approval",
                    "feature-cadence",
                    "research-efficiency",
                    "action-completion"
                  ]
                }
              }
            },
            "required": [
              "label",
              "components"
            ],
            "additionalProperties": {}
          },
          "mode": {
            "type": "string",
            "enum": [
              "data-only",
              "live-analysis"
            ]
          },
          "adminTabs": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ideas",
                "plans",
                "visuals",
                "fighters",
                "bouts",
                "events",
                "slates",
                "sources",
                "articles",
                "predictions",
                "banners",
                "calendar",
                "social-lab",
                "studio",
                "templates",
                "inspiration",
                "hooks",
                "packages",
                "shortlist",
                "dossiers",
                "features",
                "recommendations",
                "actions",
                "knowledge",
                "monitor",
                "claims",
                "library",
                "signals",
                "today",
                "timeline",
                "threads",
                "instagram",
                "reels",
                "trend-radar",
                "results",
                "experiments",
                "voice-strategy",
                "budget"
              ]
            }
          },
          "rendering": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "const": "design-lab"
              },
              "imageGeneration": {
                "type": "boolean",
                "const": false
              },
              "freeformSocialImages": {
                "type": "boolean",
                "const": false
              }
            },
            "required": [
              "path",
              "imageGeneration",
              "freeformSocialImages"
            ],
            "additionalProperties": false
          },
          "productionJobs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "cadence": {
                  "type": "string",
                  "pattern": "^(?:2x-daily@\\d{2}:00,\\d{2}:00|daily@(?:0[5-9]|1\\d|2[0-3]):00)$"
                },
                "envelopeUsd": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "kind",
                "cadence",
                "envelopeUsd"
              ],
              "additionalProperties": {}
            }
          },
          "meetings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "cadence": {
                  "type": "string",
                  "pattern": "^daily@(?:0[5-9]|1\\d|2[0-3]):00$"
                },
                "cast": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "VIZE",
                      "FORGE",
                      "PULSE",
                      "AUDIT",
                      "SCOUT",
                      "SCRIBE",
                      "LENS",
                      "QUILL",
                      "RADAR",
                      "KEEPER",
                      "THREADS",
                      "INSTAGRAM",
                      "PEOPLE",
                      "LEDGER",
                      "HERALD",
                      "STET",
                      "HACEK",
                      "SPARK",
                      "VAULT",
                      "FRAME",
                      "RELAY",
                      "ANGLE",
                      "COHORT",
                      "FUNNEL",
                      "PALATE",
                      "SCENE",
                      "STUNT",
                      "CORNER",
                      "SPOTTER",
                      "TAPE",
                      "SIGMA",
                      "VIG",
                      "SONAR",
                      "CANVAS",
                      "JAB",
                      "REACH",
                      "SPLIT",
                      "EASEL",
                      "MOTIF",
                      "PIVOT",
                      "MAKO",
                      "CHUM",
                      "FOLIO",
                      "PLOT",
                      "GHOST",
                      "BOOKER",
                      "LETOPIS",
                      "VERBA",
                      "TRIBUN"
                    ]
                  }
                },
                "envelopeUsd": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "packet": {
                  "type": "object",
                  "properties": {
                    "topicType": {
                      "type": "string",
                      "enum": [
                        "growth",
                        "build",
                        "evidence",
                        "finance",
                        "social",
                        "org",
                        "incident",
                        "council",
                        "edition",
                        "product"
                      ]
                    },
                    "decisionNeeded": {
                      "type": "string",
                      "enum": [
                        "PLAN",
                        "NO_ACTION",
                        "VERDICT",
                        "MEMO",
                        "EDITION",
                        "IDEA_VERDICT"
                      ]
                    },
                    "preset": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "objectives": {
                      "type": "object",
                      "properties": {
                        "dry": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 400
                        },
                        "live": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 400
                        }
                      },
                      "required": [
                        "dry",
                        "live"
                      ],
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "topicType",
                    "decisionNeeded",
                    "preset",
                    "objectives"
                  ],
                  "additionalProperties": {}
                }
              },
              "required": [
                "kind",
                "label",
                "cadence",
                "cast",
                "envelopeUsd",
                "packet"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "visibility",
          "taste",
          "ledgerNamespace",
          "growth_objective",
          "adminTabs",
          "meetings"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schemaVersion",
    "ventures"
  ],
  "additionalProperties": {},
  "$id": "https://boardless.ai/contracts/venture-registry.schema.json"
}
