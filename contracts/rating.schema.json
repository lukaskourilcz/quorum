{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "rating/1"
    },
    "id": {
      "type": "string",
      "pattern": "^r-\\d{4}-\\d{2}-\\d{2}-[a-f0-9]{4,12}$"
    },
    "ventureId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "objectKind": {
      "type": "string",
      "enum": [
        "idea",
        "plan",
        "visual",
        "slate",
        "article",
        "social-variant",
        "template"
      ]
    },
    "objectRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{12}$"
        }
      },
      "required": [
        "id",
        "contentHash"
      ],
      "additionalProperties": {}
    },
    "rating": {
      "type": "string",
      "enum": [
        "perfect",
        "good",
        "bad"
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 500
    },
    "ratedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "ventureId",
    "objectKind",
    "objectRef",
    "rating",
    "ratedAt"
  ],
  "additionalProperties": {},
  "$id": "https://boardless.ai/contracts/rating.schema.json"
}
