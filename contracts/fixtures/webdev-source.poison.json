  },
  "limits": {
    "cadenceMinutes": 360,
    "requestCapPerRun": 2,
    "pageCapPerRun": 2,
    "itemCapPerRun": 100,
    "bodyBytes": 500000,
    "timeoutMs": 10000,
    "redirects": 1,
    "concurrency": 1,
    "spacingMs": 1000
  },
  "conditional": {
    "etag": "supported-unverified",
    "lastModified": "not-observed",
    "contentHashFallback": true
  },
  "parser": {
    "id": "github-advisories",
    "version": "1.0.0",
    "fixtureVersion": "1.0.0"
  },
  "healthPolicy": {
    "failureThreshold": 3,
    "layoutChangeHoldsSource": true,
    "emptyIsHealthy": true,
    "unchangedIsHealthy": true
  },
  "priority": 100,
  "duplicateOverlap": [],
  "state": "enabled",
  "stateReason": "Retained official structured security authority from the dated audit.",
  "sourceRefs": [
    "docs/WEBDEV-SIGNAL-SOURCES.md#github-npm-advisories"
