{
  "schemaVersion": "webdev-source/1",
  "id": "github-npm-advisories",
  "name": "GitHub npm advisories",
  "project": "GitHub Advisory Database",
  "owner": "GitHub",
  "canonicalHost": "api.github.com",
  "sourceKind": "github-advisories",
  "authority": "official-advisory",
  "endpoint": "http://api.github.com/advisories?ecosystem=npm",
  "repositoryRef": null,
  "locale": "en",
  "topics": [
    "security",
    "package-manager"
  ],
  "changeKinds": [
    "security-advisory"
  ],
  "verifiedAt": "2026-08-28",
  "verificationDueAt": "2026-11-26",
  "access": {
    "publicLoggedOut": true,
    "authEnvironmentName": null,
    "termsRef": "https://docs.github.com/en/site-policy/github-terms/github-terms-of-service",
    "robotsRef": null,
    "license": "Advisory-specific; retain attribution and source links",
