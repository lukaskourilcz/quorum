{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "social-strategy-adjustment/1"
    },
    "id": {
      "type": "string",
      "pattern": "^social-strategy-adjustment-[a-f0-9]{20}$"
    },
    "adjustmentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profileId": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^social-profile-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "strategyId": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^social-profile-strategy-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "baseVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "nextVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "owner-approved",
        "applied",
        "vetoed",
        "corrected"
      ]
    },
    "change": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "format-priority",
            "preferred-window",
            "reserve-mix",
            "source-usefulness",
            "goviral-usefulness",
            "asset-template-preference",
            "campaign-support-frequency"
          ]
        },
        "targetRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "beforeRank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "afterRank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "delta": {
          "type": "integer",
          "minimum": -1,
          "maximum": 1
        }
      },
      "required": [
        "kind",
        "targetRef",
        "beforeRank",
        "afterRank",
        "delta"
      ],
      "additionalProperties": false
    },
    "evidenceEvaluationRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "evidenceObservationRefs": {
      "minItems": 3,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "hardGatesFrozen": {
      "minItems": 12,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "purpose",
          "capability",
          "privacy",
          "evidence",
          "original-support-ratio",
          "runway",
          "cooldown",
          "duplicate",
          "stagger",
          "authority",
          "cost",
          "kill-switch"
        ]
      }
    },
    "createsSourceOrTarget": {
      "type": "boolean",
      "const": false
    },
    "createsCapabilityOrScope": {
      "type": "boolean",
      "const": false
    },
    "ownerDecisionRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "appliedStrategyRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "authorityGranted": {
      "type": "boolean",
      "const": false
    },
    "publishingAuthorized": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "adjustmentHash",
    "profileId",
    "strategyId",
    "baseVersion",
    "nextVersion",
    "status",
    "change",
    "evidenceEvaluationRef",
    "evidenceObservationRefs",
    "explanation",
    "hardGatesFrozen",
    "createsSourceOrTarget",
    "createsCapabilityOrScope",
    "ownerDecisionRef",
    "appliedStrategyRef",
    "createdAt",
    "updatedAt",
    "authorityGranted",
    "publishingAuthorized"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/social-strategy-adjustment.schema.json"
}
