{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "webdev-run/1"
    },
    "phase": {
      "type": "string",
      "const": "webdev-signal-daily"
    },
    "pragueDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "fixture",
        "live"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceOutcomes": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "success",
              "empty",
              "unchanged",
              "malformed",
              "layout-changed",
              "held",
              "failed"
            ]
          },
          "fetched": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kept": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "dropped": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "sourceId",
          "outcome",
          "fetched",
          "kept",
          "dropped"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "new": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duplicate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "malformed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "candidates",
        "new",
        "updated",
        "duplicate",
        "malformed"
      ],
      "additionalProperties": false
    },
    "selectionOutcome": {
      "type": "string",
      "enum": [
        "selected",
        "NO_EDITION",
        "held"
      ]
    },
    "selectionRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "briefRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "packageRefs": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "renderRefs": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "queueRefs": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "reservations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "reservedUsd": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.03
        },
        "actualUsd": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.03
        }
      },
      "required": [
        "reservations",
        "calls",
        "provider",
        "model",
        "reservedUsd",
        "actualUsd"
      ],
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "properties": {
        "unchangedSources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reusedArtifacts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "providerCallsAvoided": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "unchangedSources",
        "reusedArtifacts",
        "providerCallsAvoided"
      ],
      "additionalProperties": false
    },
    "errors": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
          },
          "sourceId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160,
                "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "code",
          "sourceId",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "nextSafeAction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "schemaVersion",
    "phase",
    "pragueDate",
    "mode",
    "idempotencyKey",
    "sourceOutcomes",
    "counts",
    "selectionOutcome",
    "selectionRef",
    "briefRef",
    "packageRefs",
    "renderRefs",
    "queueRefs",
    "model",
    "cache",
    "errors",
    "nextSafeAction"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/webdev-run.schema.json"
}
