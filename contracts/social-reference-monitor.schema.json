{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "social-reference-monitor/1"
    },
    "sampledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "posts": {
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "account": {
            "type": "string",
            "enum": [
              "evolving.ai",
              "activeprogrammer"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https:\\/\\/www\\.instagram\\.com\\/(?:p|reel)\\/[A-Za-z0-9_-]+\\/$"
          },
          "postedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "slideCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "captionWords": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          },
          "questionHook": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "account",
          "url",
          "postedAt",
          "slideCount",
          "captionWords",
          "questionHook"
        ],
        "additionalProperties": false
      }
    },
    "newPostIds": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "publishingAuthorized": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "sampledAt",
    "expiresAt",
    "posts",
    "newPostIds",
    "publishingAuthorized"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/social-reference-monitor.schema.json"
}
