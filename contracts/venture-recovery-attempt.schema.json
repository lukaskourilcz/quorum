{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "venture-recovery-attempt/1"
    },
    "attemptId": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^[a-z0-9]+(?:[.:_-][a-z0-9]+)*$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "nodeId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "itemRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "conditionKey": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z0-9]+(?:[.:_-][a-z0-9]+)*$"
    },
    "triggerHealthRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "triggerSloRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "evidenceRefs": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "policyRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "policyVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "action": {
      "type": "string",
      "enum": [
        "replay-idempotent-job",
        "reconcile-ambiguous",
        "reuse-last-valid",
        "deterministic-fallback",
        "reduce-optional-work",
        "rebuild-derived-view",
        "isolate-malformed-item",
        "release-stale-lock",
        "postpone-next-window",
        "pause-scope",
        "resume-transient"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "dry",
        "fixture",
        "validation"
      ]
    },
    "beforeStateHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expectedSafeOutcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "costReservationUsd": {
      "type": "number",
      "minimum": 0
    },
    "actualCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "result": {
      "type": "string",
      "enum": [
        "recovered",
        "unchanged",
        "held",
        "failed",
        "ambiguous",
        "paused",
        "owner-required"
      ]
    },
    "afterStateRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "receiptRefs": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "nextEligibleAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ownerAttentionRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedesAttemptRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "attemptId",
    "idempotencyKey",
    "nodeId",
    "phase",
    "jobId",
    "itemRef",
    "conditionKey",
    "triggerHealthRef",
    "triggerSloRef",
    "evidenceRefs",
    "policyRef",
    "policyVersion",
    "action",
    "mode",
    "beforeStateHash",
    "expectedSafeOutcome",
    "startedAt",
    "endedAt",
    "durationMs",
    "costReservationUsd",
    "actualCostUsd",
    "result",
    "afterStateRef",
    "receiptRefs",
    "error",
    "nextEligibleAt",
    "ownerAttentionRef",
    "supersedesAttemptRef"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/venture-recovery-attempt.schema.json"
}
