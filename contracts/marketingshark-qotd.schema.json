{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "marketingshark-qotd/1"
    },
    "id": {
      "type": "string",
      "pattern": "^ms-qotd-\\d{4}-\\d{2}-\\d{2}-devshark$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "brandId": {
      "type": "string",
      "const": "devshark"
    },
    "platform": {
      "type": "string",
      "const": "threads"
    },
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "correctIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "required": [
        "id",
        "category",
        "difficulty",
        "correctIndex"
      ],
      "additionalProperties": false
    },
    "bank": {
      "type": "object",
      "properties": {
        "sourceRepo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sourceCommit": {
          "type": "string",
          "minLength": 7,
          "maxLength": 64
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "sourceRepo",
        "sourceCommit",
        "contentHash"
      ],
      "additionalProperties": false
    },
    "post": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "firstReply": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "link": {
          "type": "string",
          "pattern": "^https:\\/\\/"
        }
      },
      "required": [
        "text",
        "link"
      ],
      "additionalProperties": false
    },
    "publishWindow": {
      "type": "object",
      "properties": {
        "prague": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "notBefore": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "notAfter": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "prague",
        "notBefore",
        "notAfter"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "const": "draft"
    },
    "spendUsd": {
      "type": "number",
      "const": 0
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "date",
    "brandId",
    "platform",
    "question",
    "bank",
    "post",
    "firstReply",
    "publishWindow",
    "status",
    "spendUsd"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/marketingshark-qotd.schema.json"
}
