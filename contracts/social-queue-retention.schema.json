{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "social-queue-retention/1"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "retentionDays": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 3650
    },
    "keepFrom": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "removedItems": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^state\\/social\\/queue\\/[a-z0-9][a-z0-9._-]*\\.json$"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "type": "string",
            "enum": [
              "published",
              "cancelled",
              "expired",
              "failed"
            ]
          },
          "lastActivity": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "id",
          "status",
          "lastActivity",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "removedEvents": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^state\\/social\\/queue-events\\/[a-zA-Z0-9][a-zA-Z0-9._-]*\\.json$"
          },
          "itemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "at": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "itemId",
          "at",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "keptItems": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "keptEvents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "heldByLink": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unmanagedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "date",
    "retentionDays",
    "keepFrom",
    "removedItems",
    "removedEvents",
    "keptItems",
    "keptEvents",
    "heldByLink",
    "unmanagedCount"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/social-queue-retention.schema.json"
}
