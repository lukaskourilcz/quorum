{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "operations-capacity-plan/1"
    },
    "period": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "timezone": {
      "type": "string",
      "const": "Europe/Prague"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "budget": {
      "type": "object",
      "properties": {
        "maximumUsd": {
          "type": "number",
          "minimum": 0
        },
        "spentUsd": {
          "type": "number",
          "minimum": 0
        },
        "reservedUsd": {
          "type": "number",
          "minimum": 0
        },
        "headroomUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "maximumUsd",
        "spentUsd",
        "reservedUsd",
        "headroomUsd"
      ],
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "guardActive": {
          "type": "boolean"
        },
        "releaseReady": {
          "type": "boolean"
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scheduled": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "guardActive",
        "releaseReady",
        "evidenceRef",
        "scheduled"
      ],
      "additionalProperties": false
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "nodeId": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "phase": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "classification": {
            "type": "string",
            "enum": [
              "mandatory",
              "optional",
              "held"
            ]
          },
          "dueAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "expectedCostUsd": {
            "type": "number",
            "minimum": 0
          },
          "nodeBudgetHeadroomUsd": {
            "type": "number",
            "minimum": 0
          },
          "providerIds": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^[a-z0-9]+(?:[.:/_-][a-z0-9]+)*$"
            }
          },
          "writerPaths": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^[a-z0-9]+(?:[.:/_-][a-z0-9]+)*$"
            }
          },
          "inputHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "configHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "modelVersion": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "dependencyHealthRefs": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "decision": {
            "type": "string",
            "enum": [
              "run",
              "reuse",
              "skipped",
              "deferred",
              "held",
              "not-due"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "acceptedArtifactRef": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "nextEligibleAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "jobId",
          "nodeId",
          "phase",
          "classification",
          "dueAt",
          "expectedCostUsd",
          "nodeBudgetHeadroomUsd",
          "providerIds",
          "writerPaths",
          "inputHash",
          "configHash",
          "modelVersion",
          "dependencyHealthRefs",
          "decision",
          "reason",
          "acceptedArtifactRef",
          "nextEligibleAt"
        ],
        "additionalProperties": false
      }
    },
    "selectedExecutionOrder": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "activeLeaseRefs": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "collisionGroups": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resourceKey": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^[a-z0-9]+(?:[.:/_-][a-z0-9]+)*$"
          },
          "jobIds": {
            "minItems": 2,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        },
        "required": [
          "resourceKey",
          "jobIds"
        ],
        "additionalProperties": false
      }
    },
    "providerHeadroom": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 240,
        "pattern": "^[a-z0-9]+(?:[.:/_-][a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "due": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "running": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reused": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "held": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deferred": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "due",
        "running",
        "reused",
        "skipped",
        "held",
        "deferred"
      ],
      "additionalProperties": false
    },
    "planHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "period",
    "timezone",
    "generatedAt",
    "budget",
    "deployment",
    "jobs",
    "selectedExecutionOrder",
    "activeLeaseRefs",
    "collisionGroups",
    "providerHeadroom",
    "counts",
    "planHash"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/operations-capacity-plan.schema.json"
}
