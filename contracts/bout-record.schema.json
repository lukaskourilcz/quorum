{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "bout/1"
    },
    "id": {
      "type": "string",
      "pattern": "^(ufc|oktagon):bout:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "org": {
      "type": "string",
      "enum": [
        "ufc",
        "oktagon"
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^(ufc|oktagon):event:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "startsAtUtc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref",
        "name",
        "startsAtUtc",
        "venue"
      ],
      "additionalProperties": {}
    },
    "fighters": {
      "type": "object",
      "properties": {
        "red": {
          "type": "string",
          "pattern": "^(ufc|oktagon):[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "blue": {
          "type": "string",
          "pattern": "^(ufc|oktagon):[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "red",
        "blue"
      ],
      "additionalProperties": {}
    },
    "division": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "scheduledRounds": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number",
              "const": 3
            },
            {
              "type": "number",
              "const": 5
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "announced",
        "confirmed",
        "weigh-in",
        "completed",
        "cancelled",
        "postponed"
      ]
    },
    "statusHistory": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "announced",
              "confirmed",
              "weigh-in",
              "completed",
              "cancelled",
              "postponed"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "sourceRefs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          }
        },
        "required": [
          "status",
          "at",
          "sourceRefs",
          "note"
        ],
        "additionalProperties": {}
      }
    },
    "discovery": {
      "type": "object",
      "properties": {
        "firstSeenAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "sourceRefs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      },
      "required": [
        "firstSeenAt",
        "lastSeenAt",
        "sourceRefs"
      ],
      "additionalProperties": {}
    },
    "sourceRefs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "winner": {
              "type": "string",
              "enum": [
                "red",
                "blue",
                "draw",
                "no-contest"
              ]
            },
            "method": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "round": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                {
                  "type": "null"
                }
              ]
            },
            "elapsedSeconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1500
                },
                {
                  "type": "null"
                }
              ]
            },
            "sourceRefs": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          },
          "required": [
            "winner",
            "method",
            "round",
            "elapsedSeconds",
            "sourceRefs"
          ],
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "predictionRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "changeLog": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "created",
              "source-refresh",
              "field-update",
              "bout-added",
              "status-change",
              "owner-review",
              "rating-rebuild"
            ]
          },
          "fields": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          }
        },
        "required": [
          "at",
          "kind",
          "fields",
          "sourceRefs",
          "note"
        ],
        "additionalProperties": {}
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "org",
    "event",
    "fighters",
    "division",
    "scheduledRounds",
    "status",
    "statusHistory",
    "discovery",
    "sourceRefs",
    "result",
    "predictionRefs",
    "changeLog",
    "updatedAt"
  ],
  "additionalProperties": {},
  "$id": "https://boardless.ai/contracts/bout-record.schema.json"
}
