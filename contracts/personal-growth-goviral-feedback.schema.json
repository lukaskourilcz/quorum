{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "personal-growth-goviral-feedback/1"
    },
    "packetId": {
      "type": "string",
      "pattern": "^pg-goviral-\\d{4}-\\d{2}-\\d{2}$"
    },
    "opportunityId": {
      "type": "string",
      "pattern": "^pg-gv-[a-f0-9]{16}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "used",
        "rejected",
        "ignored",
        "posted"
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "sourcePacketHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "packetId",
    "opportunityId",
    "outcome",
    "recordedAt",
    "sourcePacketHash"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/personal-growth-goviral-feedback.schema.json"
}
