{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "boardless-stream/1"
    },
    "stream": {
      "type": "string",
      "enum": [
        "talked-about",
        "podcasts"
      ]
    },
    "updated": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "windowDays": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 365
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "pattern": "^https:\\/\\/"
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "medium",
                  "substack",
                  "blog",
                  "youtube",
                  "rss"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "feed": {
                "type": "string",
                "pattern": "^https:\\/\\/"
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": {}
          },
          "author": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "published": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 280
              },
              {
                "type": "null"
              }
            ]
          },
          "weight": {
            "type": "number"
          },
          "show": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "durationSec": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "links": {
            "type": "object",
            "properties": {
              "youtube": {
                "type": "string",
                "pattern": "^https:\\/\\/"
              },
              "spotify": {
                "type": "string",
                "pattern": "^https:\\/\\/"
              },
              "apple": {
                "type": "string",
                "pattern": "^https:\\/\\/"
              },
              "rss": {
                "type": "string",
                "pattern": "^https:\\/\\/"
              }
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "source",
          "published"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schemaVersion",
    "stream",
    "updated",
    "windowDays",
    "items"
  ],
  "additionalProperties": {},
  "$id": "https://boardless.ai/contracts/boardless-stream.schema.json"
}
