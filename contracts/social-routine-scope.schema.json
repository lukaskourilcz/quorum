{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "social-routine-scope/1"
    },
    "id": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^social-routine-scope-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "revoked",
        "expired"
      ]
    },
    "profileId": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^social-profile-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "connectionId": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^social-connection-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "threads"
      ]
    },
    "locales": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cs",
          "en"
        ]
      }
    },
    "allowedContentClasses": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "original",
          "campaign-primary",
          "campaign-umbrella",
          "campaign-amplifier"
        ]
      }
    },
    "allowedFormats": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "allowedSourceKinds": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "strategy-owned",
          "accepted-campaign",
          "approved-package"
        ]
      }
    },
    "evidenceRequirements": {
      "type": "object",
      "properties": {
        "minimumEvidenceRefs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "approvedPackageRequired": {
          "type": "boolean"
        },
        "campaignApprovalRequired": {
          "type": "boolean"
        },
        "claimsRequired": {
          "type": "boolean",
          "const": true
        },
        "accessibilityRequired": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "minimumEvidenceRefs",
        "approvedPackageRequired",
        "campaignApprovalRequired",
        "claimsRequired",
        "accessibilityRequired"
      ],
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "properties": {
        "maximumPostsPerDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "minimumHoursBetweenPosts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 168
        },
        "maximumItemCostUsd": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "maximumPostsPerDay",
        "minimumHoursBetweenPosts",
        "maximumItemCostUsd"
      ],
      "additionalProperties": false
    },
    "effectiveOn": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "expiresOn": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "prohibitedRiskClasses": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "political",
          "sensitive",
          "novel",
          "paid",
          "policy-changing"
        ]
      }
    },
    "prohibitedActions": {
      "minItems": 9,
      "maxItems": 9,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "account-create",
          "oauth",
          "credential-change",
          "provider-change",
          "engagement",
          "dm",
          "ad",
          "contest",
          "silent-failover"
        ]
      }
    },
    "approvalRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "countersignatureRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "revocationRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "killBehavior": {
      "type": "string",
      "const": "pause-and-preserve-evidence"
    },
    "history": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "action": {
            "type": "string",
            "enum": [
              "drafted",
              "countersigned",
              "tightened",
              "revoked",
              "expired",
              "corrected"
            ]
          },
          "actor": {
            "type": "string",
            "enum": [
              "owner",
              "system"
            ]
          },
          "evidenceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "revision",
          "at",
          "action",
          "actor",
          "evidenceRef",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "authorityGranted": {
      "type": "boolean",
      "const": false
    },
    "publishingAuthorized": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "profileId",
    "connectionId",
    "platform",
    "locales",
    "allowedContentClasses",
    "allowedFormats",
    "allowedSourceKinds",
    "evidenceRequirements",
    "bounds",
    "effectiveOn",
    "expiresOn",
    "prohibitedRiskClasses",
    "prohibitedActions",
    "approvalRef",
    "countersignatureRef",
    "revocationRef",
    "killBehavior",
    "history",
    "authorityGranted",
    "publishingAuthorized"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/social-routine-scope.schema.json"
}
