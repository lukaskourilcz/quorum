{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "personal-growth-feedback/1"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "sourceResultIds": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^pg-result-[a-f0-9]{16}$"
      }
    },
    "pillarWeights": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pillar": {
            "type": "string",
            "enum": [
              "life-lifestyle",
              "writing-publishing",
              "hip-hop",
              "rapovej-denik",
              "travel-places-lived",
              "prague",
              "software-products",
              "boardlessai-behind-scenes",
              "fitness-discipline-muay-thai",
              "books-reading",
              "clothing-personal-style"
            ]
          },
          "prior": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "proposed": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "sampleSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "pillar",
          "prior",
          "proposed",
          "sampleSize"
        ],
        "additionalProperties": false
      }
    },
    "formatPriors": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "goviralUtility": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reelSeriesUtility": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "manualVentureReferenceUseful": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "mutatesEvidence": {
      "type": "boolean",
      "const": false
    },
    "weakensPolicy": {
      "type": "boolean",
      "const": false
    },
    "externalDestinations": {
      "type": "array",
      "prefixItems": []
    }
  },
  "required": [
    "schemaVersion",
    "evaluatedAt",
    "sourceResultIds",
    "pillarWeights",
    "formatPriors",
    "goviralUtility",
    "reelSeriesUtility",
    "manualVentureReferenceUseful",
    "mutatesEvidence",
    "weakensPolicy",
    "externalDestinations"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/personal-growth-feedback.schema.json"
}
