{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "social-pack/1"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "editionRef": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "instagram": {
      "type": "object",
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2200
        },
        "hashtags": {
          "minItems": 5,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "frames": {
          "minItems": 3,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\/social\\/[a-zA-Z0-9/_-]+\\.webp$"
          }
        }
      },
      "required": [
        "caption",
        "hashtags",
        "frames"
      ],
      "additionalProperties": {}
    },
    "threads": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "hashtags": {
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "frames": {
          "minItems": 3,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\/social\\/[a-zA-Z0-9/_-]+\\.webp$"
          }
        }
      },
      "required": [
        "text",
        "hashtags",
        "frames"
      ],
      "additionalProperties": {}
    },
    "quoteCard": {
      "type": "object",
      "properties": {
        "frame": {
          "type": "string",
          "pattern": "^\\/social\\/[a-zA-Z0-9/_-]+\\.webp$"
        },
        "sourceTurnRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "frame",
        "sourceTurnRef"
      ],
      "additionalProperties": {}
    },
    "provenance": {
      "type": "object",
      "properties": {
        "composerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "inputsHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "composerVersion",
        "inputsHash"
      ],
      "additionalProperties": {}
    },
    "altTexts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^\\/social\\/[a-zA-Z0-9/_-]+\\.webp$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  },
  "required": [
    "schemaVersion",
    "date",
    "editionRef",
    "instagram",
    "threads",
    "quoteCard",
    "provenance",
    "altTexts"
  ],
  "additionalProperties": {},
  "$id": "https://boardless.ai/contracts/social-pack.schema.json"
}
