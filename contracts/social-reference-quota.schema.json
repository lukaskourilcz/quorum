{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "social-reference-quota/1"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "reservedUsd": {
      "type": "number",
      "minimum": 0,
      "maximum": 5.03
    },
    "attemptedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "pending": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "reserved",
        "complete",
        "failed"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "month",
    "reservedUsd",
    "attemptedAt",
    "pending",
    "status"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/social-reference-quota.schema.json"
}
