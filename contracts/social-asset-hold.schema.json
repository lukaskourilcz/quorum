{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "social-asset-hold/1"
    },
    "queueItemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "sourceVentureId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "channel": {
      "type": "string",
      "enum": [
        "instagram",
        "threads",
        "linkedin"
      ]
    },
    "base": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "jsdelivr",
            "site",
            "blob"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "asset-hash-mismatch",
        "asset-hash-unrecorded",
        "asset-unsupported",
        "asset-unreachable"
      ]
    },
    "assets": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 400,
            "pattern": "^\\/social\\/[a-zA-Z0-9/_-]+\\.[a-zA-Z0-9]+$"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 800,
                "pattern": "^https:\\/\\/"
              },
              {
                "type": "null"
              }
            ]
          },
          "commit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "recordedSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "ready",
              "base-invalid",
              "base-unbuilt",
              "hash-unrecorded",
              "uncommitted",
              "not-at-commit",
              "hash-mismatch",
              "platform-unsupported",
              "host-not-allowlisted",
              "unreachable",
              "wrong-type"
            ]
          },
          "detail": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "url",
          "commit",
          "recordedSha256",
          "outcome",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "publishingAuthorized": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "queueItemId",
    "sourceVentureId",
    "channel",
    "base",
    "reason",
    "assets",
    "checkedAt",
    "publishingAuthorized"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/social-asset-hold.schema.json"
}
