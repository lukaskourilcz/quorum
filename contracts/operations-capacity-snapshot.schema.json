{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "operations-capacity-snapshot/1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "planRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "due": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "running": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "held": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deferred": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "skipped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "estimatedCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "actualCostUsd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "artifactsReused": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duplicateRunsPrevented": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "providerCallsAvoided": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "collisionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "activeLeaseRefs": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "nextUnblockedJobId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "unavailable"
      ]
    },
    "snapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "planRef",
    "due",
    "running",
    "held",
    "deferred",
    "skipped",
    "estimatedCostUsd",
    "actualCostUsd",
    "artifactsReused",
    "duplicateRunsPrevented",
    "providerCallsAvoided",
    "collisionCount",
    "activeLeaseRefs",
    "nextUnblockedJobId",
    "freshness",
    "snapshotHash"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/operations-capacity-snapshot.schema.json"
}
