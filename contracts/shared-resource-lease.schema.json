{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "shared-resource-lease/1"
    },
    "leaseId": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^[a-z0-9]+(?:[.:_-][a-z0-9]+)*$"
    },
    "resourceType": {
      "type": "string",
      "enum": [
        "writer-path",
        "provider-capacity",
        "apify-quota",
        "renderer",
        "schedule-slot",
        "deployment-gate"
      ]
    },
    "resourceKey": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[a-z0-9]+(?:[.:/_-][a-z0-9]+)*$"
    },
    "holderNodeId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "holderJobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "acquiredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "released"
      ]
    },
    "authorityGranted": {
      "type": "boolean",
      "const": false
    },
    "contentAccessGranted": {
      "type": "boolean",
      "const": false
    },
    "spendAuthorized": {
      "type": "boolean",
      "const": false
    },
    "supersedesLeaseRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "leaseId",
    "resourceType",
    "resourceKey",
    "holderNodeId",
    "holderJobId",
    "idempotencyKey",
    "acquiredAt",
    "expiresAt",
    "state",
    "authorityGranted",
    "contentAccessGranted",
    "spendAuthorized",
    "supersedesLeaseRef"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/shared-resource-lease.schema.json"
}
