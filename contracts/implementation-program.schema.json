{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "implementation-program/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "parentIssue": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "number",
        "url"
      ],
      "additionalProperties": false
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "owner-only",
        "internal"
      ]
    },
    "repository": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "baseBranch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        }
      },
      "required": [
        "owner",
        "name",
        "baseBranch"
      ],
      "additionalProperties": false
    },
    "phases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "workItemIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "id",
          "name",
          "workItemIds"
        ],
        "additionalProperties": false
      }
    },
    "prerequisiteIssueNumbers": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "safeParallelGroups": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "workItemIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "id",
          "workItemIds"
        ],
        "additionalProperties": false
      }
    },
    "protectedFileCollisionGroups": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "paths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "required": [
          "id",
          "paths"
        ],
        "additionalProperties": false
      }
    },
    "acceptanceProbeIds": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "ownerActionProbeIds": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "finalReleaseItemId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "archived": {
      "type": "boolean"
    },
    "supersededBy": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "manifestVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "effectiveDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "parentIssue",
    "owner",
    "visibility",
    "repository",
    "phases",
    "prerequisiteIssueNumbers",
    "safeParallelGroups",
    "protectedFileCollisionGroups",
    "acceptanceProbeIds",
    "ownerActionProbeIds",
    "finalReleaseItemId",
    "archived",
    "supersededBy",
    "manifestVersion",
    "effectiveDate"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/implementation-program.schema.json"
}
