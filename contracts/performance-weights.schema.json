{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "performance-weights/1"
    },
    "ventureId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "floor": {
      "type": "number",
      "const": 0.5
    },
    "ceiling": {
      "type": "number",
      "const": 1.5
    },
    "formatPriors": {
      "type": "object",
      "properties": {
        "carousel": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        },
        "single-image": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        },
        "thread": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        },
        "caption": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        },
        "short-video-script": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        }
      },
      "required": [
        "carousel",
        "single-image",
        "thread",
        "caption",
        "short-video-script"
      ],
      "additionalProperties": false
    },
    "themePriors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 1.5
      }
    },
    "hookStylePriors": {
      "type": "object",
      "properties": {
        "narrative-led": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        },
        "quote-led": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        },
        "lesson-led": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        },
        "tension-led": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        },
        "humor-led": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        }
      },
      "required": [
        "narrative-led",
        "quote-led",
        "lesson-led",
        "tension-led",
        "humor-led"
      ],
      "additionalProperties": false
    },
    "revisions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidenceResultIds": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^owner-result-[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "changes": {
            "type": "object",
            "properties": {
              "formatPriors": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "carousel",
                    "single-image",
                    "thread",
                    "caption",
                    "short-video-script"
                  ]
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 1.5
                }
              },
              "themePriors": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 1.5
                }
              },
              "hookStylePriors": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "narrative-led",
                    "quote-led",
                    "lesson-led",
                    "tension-led",
                    "humor-led"
                  ]
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 1.5
                }
              }
            },
            "required": [
              "formatPriors",
              "themePriors",
              "hookStylePriors"
            ],
            "additionalProperties": false
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sourceCycleId": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "rationale",
          "evidenceResultIds",
          "changes",
          "revision",
          "sourceCycleId",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "ventureId",
    "floor",
    "ceiling",
    "formatPriors",
    "themePriors",
    "hookStylePriors",
    "revisions",
    "generatedAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/performance-weights.schema.json"
}
