{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "performance-weights/1"
    },
    "ventureId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "floor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ceiling": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "lanes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "additionalProperties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        }
      }
    },
    "appliedProposalIds": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^weights-[a-f0-9]{20}$"
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "ventureId",
    "floor",
    "ceiling",
    "lanes",
    "appliedProposalIds",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/performance-weights.schema.json"
}
