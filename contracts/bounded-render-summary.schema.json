{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "bounded-render-summary/1"
    },
    "sourceId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceArtifactRef": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^state\\/ventures\\/[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-zA-Z0-9._/-]+\\.json$"
    },
    "locale": {
      "type": "string",
      "enum": [
        "cs",
        "en"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "points": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 220
      }
    },
    "approvalRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "sourceId",
    "sourceArtifactRef",
    "locale",
    "title",
    "points",
    "approvalRef",
    "contentHash"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/bounded-render-summary.schema.json"
}
