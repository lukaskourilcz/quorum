{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "tehdejsi-shortlist/1"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "factsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "goViralPlanRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^ventures\\/goviral\\/plans\\/plan-\\d{4}-\\d{2}-\\d{2}-weekly-brief\\.json$"
        },
        {
          "type": "null"
        }
      ]
    },
    "entries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "factId": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number"
          },
          "factors": {
            "type": "object",
            "properties": {
              "askability": {
                "type": "number"
              },
              "anniversary": {
                "type": "number"
              },
              "culturalMoment": {
                "type": "number"
              },
              "wartimeAwareness": {
                "type": "number"
              },
              "sourceConfidence": {
                "type": "number"
              },
              "countryBalance": {
                "type": "number"
              },
              "tierCost": {
                "type": "number"
              },
              "performanceMultiplier": {
                "default": 1,
                "type": "number",
                "minimum": 0.75,
                "maximum": 1.25
              }
            },
            "required": [
              "askability",
              "anniversary",
              "culturalMoment",
              "wartimeAwareness",
              "sourceConfidence",
              "countryBalance",
              "tierCost",
              "performanceMultiplier"
            ],
            "additionalProperties": false
          },
          "veto": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "tier-2-review-required",
                  "recently-used"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "rank",
          "factId",
          "score",
          "factors",
          "veto"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "date",
    "factsHash",
    "goViralPlanRef",
    "entries"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/tehdejsi-shortlist.schema.json"
}
