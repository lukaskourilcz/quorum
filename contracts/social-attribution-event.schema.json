{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "social-attribution-event/1"
    },
    "id": {
      "type": "string",
      "pattern": "^social-attribution-event-[a-f0-9]{20}$"
    },
    "idempotencyHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "string",
      "enum": [
        "first-party-destination",
        "owner-manual"
      ]
    },
    "eventType": {
      "type": "string",
      "enum": [
        "referral-visit",
        "qualified-action",
        "conversion"
      ]
    },
    "eventCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "destination": {
      "type": "string",
      "pattern": "^https:\\/\\/"
    },
    "utm": {
      "type": "object",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "instagram",
                "threads"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "medium": {
          "anyOf": [
            {
              "type": "string",
              "const": "organic_social"
            },
            {
              "type": "null"
            }
          ]
        },
        "campaign": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "medium",
        "campaign",
        "content"
      ],
      "additionalProperties": false
    },
    "attribution": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "attributed",
            "unattributed",
            "invalid"
          ]
        },
        "campaignRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "campaignItemId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "profileId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 140,
              "pattern": "^social-profile-[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetRole": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "primary",
                "umbrella",
                "amplifier"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "campaignRef",
        "campaignItemId",
        "profileId",
        "targetRole"
      ],
      "additionalProperties": false
    },
    "deduplicationKey": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceRefs": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "identityExcluded": {
      "type": "boolean",
      "const": true
    },
    "fingerprintingExcluded": {
      "type": "boolean",
      "const": true
    },
    "consentInferred": {
      "type": "boolean",
      "const": false
    },
    "sharingInferred": {
      "type": "boolean",
      "const": false
    },
    "relationshipKitRef": {
      "type": "null"
    },
    "contestRef": {
      "type": "null"
    },
    "authorityGranted": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "idempotencyHash",
    "source",
    "eventType",
    "eventCount",
    "occurredAt",
    "observedAt",
    "destination",
    "utm",
    "attribution",
    "deduplicationKey",
    "evidenceRefs",
    "identityExcluded",
    "fingerprintingExcluded",
    "consentInferred",
    "sharingInferred",
    "relationshipKitRef",
    "contestRef",
    "authorityGranted"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/social-attribution-event.schema.json"
}
