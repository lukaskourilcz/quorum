{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "release-proof/1"
    },
    "id": {
      "type": "string",
      "pattern": "^proof-[a-f0-9]{16}$"
    },
    "venture": {
      "type": "string",
      "enum": [
        "caught-up",
        "mma-files"
      ]
    },
    "packageHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetRepository": {
      "type": "string",
      "enum": [
        "lukaskourilcz/aifirst",
        "lukaskourilcz/mma-files"
      ]
    },
    "targetCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "deploymentUrl": {
      "type": "string",
      "pattern": "^https:\\/\\/"
    },
    "checks": {
      "minItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "target-commit",
              "target-ci",
              "english-route",
              "czech-route",
              "title-slug",
              "content-hash",
              "hero-image",
              "image-dimensions",
              "attribution"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "name",
          "status",
          "detail",
          "checkedAt"
        ],
        "additionalProperties": {}
      }
    },
    "retryCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "reverted"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "revertCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "venture",
    "packageHash",
    "targetRepository",
    "targetCommit",
    "deploymentUrl",
    "checks",
    "retryCount",
    "status",
    "startedAt",
    "completedAt"
  ],
  "additionalProperties": {},
  "$id": "https://boardless.ai/contracts/release-proof.schema.json"
}
