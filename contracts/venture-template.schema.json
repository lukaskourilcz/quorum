{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "venture-template/1"
    },
    "templateId": {
      "type": "string",
      "const": "content-venture-default"
    },
    "dailyEnvelopeCapUsd": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.15
    },
    "allowedDeliveryTargets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "boardless-site",
          "caught-up",
          "mma-files"
        ]
      }
    },
    "existingRosterOnly": {
      "type": "boolean",
      "const": true
    },
    "newCredentialsAllowed": {
      "type": "boolean",
      "const": false
    },
    "newAccountsAllowed": {
      "type": "boolean",
      "const": false
    },
    "commerceAllowed": {
      "type": "boolean",
      "const": false
    },
    "paymentsAllowed": {
      "type": "boolean",
      "const": false
    },
    "adsAllowed": {
      "type": "boolean",
      "const": false
    },
    "personalDataAllowed": {
      "type": "boolean",
      "const": false
    },
    "newLegalSurfaceAllowed": {
      "type": "boolean",
      "const": false
    },
    "newSocialAccountsAllowed": {
      "type": "boolean",
      "const": false
    },
    "minimumSlotGapMinutes": {
      "type": "integer",
      "minimum": 60,
      "maximum": 240
    },
    "requiredFiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "STYLEBOOK.md",
          "README.md"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "templateId",
    "dailyEnvelopeCapUsd",
    "allowedDeliveryTargets",
    "existingRosterOnly",
    "newCredentialsAllowed",
    "newAccountsAllowed",
    "commerceAllowed",
    "paymentsAllowed",
    "adsAllowed",
    "personalDataAllowed",
    "newLegalSurfaceAllowed",
    "newSocialAccountsAllowed",
    "minimumSlotGapMinutes",
    "requiredFiles"
  ],
  "additionalProperties": {},
  "$id": "https://boardless.ai/contracts/venture-template.schema.json"
}
