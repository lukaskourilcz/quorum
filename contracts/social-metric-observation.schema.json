{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "social-metric-observation/1"
    },
    "id": {
      "type": "string",
      "pattern": "^social-metric-observation-[a-f0-9]{20}$"
    },
    "idempotencyHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "correctionOfRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "profileId": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^social-profile-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "targetRole": {
      "type": "string",
      "enum": [
        "primary",
        "umbrella",
        "amplifier"
      ]
    },
    "connectionId": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^social-connection-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "threads"
      ]
    },
    "nativePostId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^https:\\/\\/"
    },
    "campaignRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "campaignItemId": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "releaseId": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceVentureId": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilityRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "mapVersion": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "source": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "target": {
              "type": "string",
              "const": "social-distribution"
            },
            "capability": {
              "type": "string",
              "const": "approved-publish-package"
            },
            "dataSchemaVersion": {
              "type": "string",
              "const": "approved-publish-package/1"
            },
            "decisionReference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "mapVersion",
            "source",
            "target",
            "capability",
            "dataSchemaVersion",
            "decisionReference"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "maturityWindow": {
      "type": "string",
      "enum": [
        "24h",
        "72h",
        "7d",
        "28d"
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "official-meta",
            "destination-analytics",
            "owner-manual"
          ]
        },
        "providerId": {
          "type": "string",
          "enum": [
            "direct-meta",
            "first-party-destination",
            "owner-manual"
          ]
        },
        "implementationVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "bindingRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "source",
        "providerId",
        "implementationVersion",
        "apiVersion",
        "bindingRef",
        "evidenceRef"
      ],
      "additionalProperties": false
    },
    "format": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "carousel",
        "reel",
        "video"
      ]
    },
    "locale": {
      "type": "string",
      "enum": [
        "cs",
        "en"
      ]
    },
    "amplifier": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "archetype": {
              "type": "string",
              "enum": [
                "topic-editorial",
                "language-market",
                "geography-community",
                "format",
                "audience"
              ]
            },
            "policyRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "strategyRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "archetype",
            "policyRef",
            "strategyRef"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "policyState": {
      "type": "object",
      "properties": {
        "amplificationPolicyRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "strategyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "originalSupportClassification": {
          "type": "string",
          "enum": [
            "original",
            "support"
          ]
        },
        "originalRatio": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "supportRatio": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "runwayState": {
          "type": "string",
          "enum": [
            "healthy",
            "low-runway",
            "no-candidate",
            "held",
            "unavailable"
          ]
        },
        "cooldownState": {
          "type": "string",
          "enum": [
            "clear",
            "held",
            "unavailable"
          ]
        },
        "campaignState": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "held",
            "in-progress",
            "not-applicable",
            "unavailable"
          ]
        }
      },
      "required": [
        "amplificationPolicyRef",
        "strategyRef",
        "originalSupportClassification",
        "originalRatio",
        "supportRatio",
        "runwayState",
        "cooldownState",
        "campaignState"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "verified_publish",
              "reach",
              "views",
              "impressions",
              "non_follower_reach",
              "non_follower_reach_ratio",
              "shares",
              "reposts",
              "quotes",
              "saves",
              "replies",
              "comments",
              "likes",
              "profile_actions",
              "referral_visits",
              "qualified_actions",
              "conversions",
              "original_ratio",
              "support_ratio",
              "runway_holds",
              "cooldown_holds",
              "campaign_holds",
              "campaign_failures",
              "time_to_distribute_seconds"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "unavailableReason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "not-returned",
                  "unsupported-metric",
                  "unsupported-account",
                  "missing-permission",
                  "missing-credential",
                  "expired-token",
                  "app-review-expired",
                  "rate-limited",
                  "provider-outage",
                  "provider-error",
                  "malformed-item",
                  "no-post",
                  "invalid-denominator",
                  "analytics-unavailable",
                  "manual-only",
                  "outcome-pending",
                  "insufficient-amplifier-baseline"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "value",
          "unavailableReason"
        ],
        "additionalProperties": false
      }
    },
    "attributionRefs": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "unavailableReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "not-returned",
            "unsupported-metric",
            "unsupported-account",
            "missing-permission",
            "missing-credential",
            "expired-token",
            "app-review-expired",
            "rate-limited",
            "provider-outage",
            "provider-error",
            "malformed-item",
            "no-post",
            "invalid-denominator",
            "analytics-unavailable",
            "manual-only",
            "outcome-pending",
            "insufficient-amplifier-baseline"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceProvenanceRefs": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "actualCostUsd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "droppedMetricCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "audienceIdentityExcluded": {
      "type": "boolean",
      "const": true
    },
    "privateMessageExcluded": {
      "type": "boolean",
      "const": true
    },
    "rawProviderPayloadExcluded": {
      "type": "boolean",
      "const": true
    },
    "authorityGranted": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "idempotencyHash",
    "snapshotHash",
    "correctionOfRef",
    "profileId",
    "targetRole",
    "connectionId",
    "platform",
    "nativePostId",
    "publicUrl",
    "campaignRef",
    "campaignItemId",
    "releaseId",
    "sourceVentureId",
    "capabilityRef",
    "publishedAt",
    "observedAt",
    "maturityWindow",
    "provider",
    "format",
    "locale",
    "amplifier",
    "policyState",
    "metrics",
    "attributionRefs",
    "unavailableReason",
    "sourceProvenanceRefs",
    "actualCostUsd",
    "droppedMetricCount",
    "audienceIdentityExcluded",
    "privateMessageExcluded",
    "rawProviderPayloadExcluded",
    "authorityGranted"
  ],
  "additionalProperties": false,
  "$id": "https://boardless.ai/contracts/social-metric-observation.schema.json"
}
