{
  "name": "boardlessai",
  "version": "0.1.0",
  "private": true,
  "description": "A transparent, agent-operated company with evidence, budget and release guardrails.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agents:validate": "pnpm --filter @boardlessai/orchestrator agents:validate",
    "contracts:export": "pnpm --filter @boardlessai/orchestrator exec tsx src/contracts/export-json-schema.ts",
    "build": "pnpm docs:refresh && pnpm -r build",
    "budget:alert": "pnpm --filter @boardlessai/orchestrator budget:alert",
    "cycle": "pnpm --filter @boardlessai/orchestrator cycle",
    "cycle:phase": "pnpm --filter @boardlessai/orchestrator cycle:phase",
    "delivery": "pnpm --filter @boardlessai/orchestrator delivery",
    "release:verify": "pnpm --filter @boardlessai/orchestrator release:verify",
    "digest:daily": "pnpm --filter @boardlessai/orchestrator digest:daily",
    "docs:check": "pnpm --filter @boardlessai/orchestrator docs:refresh -- --check",
    "docs:refresh": "pnpm --filter @boardlessai/orchestrator docs:refresh",
    "dev": "pnpm --filter @boardlessai/carousel-studio build && pnpm --filter @boardlessai/site dev",
    "edition:dry": "pnpm --filter @boardlessai/orchestrator edition:dry",
    "fightaiq:backfill": "pnpm --filter @boardlessai/orchestrator fightaiq:backfill",
    "fightaiq:roster-sync": "pnpm --filter @boardlessai/orchestrator fightaiq:roster-sync",
    "ideas:migrate": "pnpm --filter @boardlessai/orchestrator ideas:migrate",
    "mma:delivery": "pnpm --filter @boardlessai/orchestrator mma:delivery",
    "lint": "pnpm -r lint",
    "lint:hooks": "pnpm --filter @boardlessai/orchestrator exec tsx ../studio/src/hooks/lint-cli.ts",
    "hooks:vectors": "pnpm --filter @boardlessai/orchestrator exec tsx ../studio/src/hooks/vectors-cli.ts",
    "marketingshark:stage-banner": "pnpm --filter @boardlessai/orchestrator exec tsx ../scripts/marketingshark-stage-banner.ts",
    "marketingshark:import-bank": "pnpm --filter @boardlessai/orchestrator exec tsx ../scripts/marketingshark-import-bank.ts",
    "org:maintain": "pnpm --filter @boardlessai/orchestrator org:maintain",
    "proof:rooms": "pnpm --filter @boardlessai/orchestrator proof:rooms",
    "social:publish": "pnpm --filter @boardlessai/orchestrator social:publish",
    "sources:shadow": "pnpm --filter @boardlessai/orchestrator sources:shadow",
    "site:smoke": "node scripts/smoke-site.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "fightaiq:roster-prune": "pnpm --filter @boardlessai/orchestrator fightaiq:roster-prune",
    "social:deck": "pnpm --filter @boardlessai/orchestrator run social:deck",
    "datasets:append": "pnpm --filter @boardlessai/orchestrator datasets:append"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "^1.1.18",
      "js-yaml@<4.3.1": "^4.3.1",
      "nanoid@<3.3.17": "^3.3.17"
    }
  }
}
