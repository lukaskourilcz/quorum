STACKEXCHANGE_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
THE_ODDS_API_KEY=
CITO_API_KEY=
# Apify Free plan only. Its $5 monthly platform credit is the budget guard: actors stop when it
# runs out, so no cash is at risk. Without this token GoVIRAL scouting is a $0 no-op.
APIFY_TOKEN=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# The generated-illustration rung, between the licensed search and the FRAME plate. Both are
# required: a key with no flag is an account nobody has decided about, and a flag with no key
# cannot render. Prepaid credit only, no subscription. Two images a day across both magazines,
# inside the $0.10 daily cap the whole image programme shares — about $0.09 a month at the cap.
FAL_KEY=
ARTICLE_ILLUSTRATION_ENABLED=
GITHUB_TOKEN=
RESEND_API_KEY=
