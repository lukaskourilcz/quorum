# The four caps below are the ones in .github/workflows/cycle.yml, from budget-2026-08e: a $30
# all-in month, a $25 model share and a $1.00 daily pace. This file carried the superseded
# budget-2026-08d numbers, so a local run was configured against limits the company left behind.
MONTHLY_OPERATING_CAP_USD=30
MAX_CYCLE_BUDGET_USD=0.20
CU_MEETING_BUDGET_USD=0.08
EDITION_PRODUCTION_BUDGET_USD=0.50
DAILY_BUDGET_USD=1.00
MONTHLY_BUDGET_USD=25
BOARDROOM_MAX_ROUNDS=2
BOARDROOM_MAX_TURNS=6
BOARDROOM_MAX_TOTAL_TOKENS=12000
ADMIN_USER=
ADMIN_PASSWORD=
