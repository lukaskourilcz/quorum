  "rules": [
    "Always spell it devShark.",
    "The fin sits left of the name, its tip pointing left, with one wave and a transparent cut-out.",
    "Green on white or light grounds, white on ink or green, ink for one-colour print.",
    "Clear space on every side equals the height of the letter d.",
    "The favicon and embroidery use the clean fin only.",
    "All files draw the name as outlines; PNG exports have transparent backgrounds."
  ],
  "doNots": [
    "Do not use gradients.",
    "Do not add shadows.",
    "Do not add 3D effects.",
    "Do not use the V1-V10 working variants in production."
  ],
  "socialRules": [
    "A carousel is 5 slides at 1080 × 1350.",
    "Slide grounds run Ink, Pale #f3f6f1, Green, Pale, Ink.",
    "The clean fin sits at 48 px in the corner of every slide.",
    "The full logo appears only on the last slide.",
    "devShark is named once, at the end."
  ],
  "typography": [
    "The name is drawn as outlines in every logo file; do not set it in a font."
  ],
