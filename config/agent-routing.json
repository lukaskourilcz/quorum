    },
    "STET": {
      "capabilities": ["editorial:copy", "quality:slop"],
      "status": "active"
    },
    "HACEK": {
      "capabilities": ["editorial:czech", "translation:fidelity", "social:czech"],
      "status": "active"
    },
    "SPARK": {
      "capabilities": ["growth:product", "bridge:venture"],
      "status": "active"
