    "VIG": {
      "capabilities": ["mma:odds", "mma:market", "responsible_play"],
      "status": "active"
    },
    "SONAR": {
      "capabilities": ["mma:sources", "source:terms", "source:discovery"],
      "status": "active"
    },
    "CANVAS": {
      "capabilities": ["editorial:chair", "mma:newsroom", "language:bilingual"],
      "status": "active"
    },
    "JAB": {
      "capabilities": ["editorial:writing", "mma:reporting", "language:english"],
      "status": "active"
