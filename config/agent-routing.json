      "capabilities": ["experiment:analysis", "social:metrics", "statistics"],
      "status": "active"
    },
    "PIVOT": {
      "capabilities": ["mma:bridge", "evidence", "portfolio:liaison"],
      "status": "active"
    }
  },
  "mandatoryWhen": [
    {
      "any": ["spend", "pricing", "revenue", "cost"],
      "include": ["LEDGER"]
    },
    {
      "any": ["external_spend"],
      "include": ["KEEPER"]
    },
    {
      "any": ["org_change"],
      "include": ["PEOPLE", "AUDIT", "KEEPER"]
    },
    {
      "any": ["public_claim"],
      "include": ["QUILL", "AUDIT", "KEEPER"]
    },
    {
      "any": ["public_social"],
      "include": ["KEEPER"]
    },
    {
      "any": ["security", "incident"],
      "include": ["AUDIT", "KEEPER", "FORGE"]
    },
    {
      "any": ["social:threads"],
      "include": ["PULSE", "THREADS", "QUILL"]
    },
    {
      "any": ["social:instagram"],
      "include": ["PULSE", "INSTAGRAM", "QUILL"]
    },
    {
      "any": ["visual", "media:compose"],
      "include": ["FRAME"]
    },
    {
      "any": ["delivery", "notification", "email", "calendar"],
      "include": ["RELAY"]
    },
    {
      "any": ["source_coverage_low"],
      "include": ["SCOUT"]
    }
  ],
  "presets": {
    "daily-standup": {
      "required": ["VIZE", "FORGE", "PULSE", "AUDIT", "LEDGER"],
      "optionalByTopic": true
    },
    "venture-morning": {
      "required": ["VIZE", "FORGE", "PULSE", "AUDIT", "LEDGER", "SPARK"],
      "optionalByTopic": true
    },
    "edition-room": {
      "required": ["HERALD", "STET", "HACEK", "SPARK", "AUDIT"],
      "optionalByTopic": true
    },
    "product-room": {
      "required": ["HERALD", "SPARK", "VAULT", "AUDIT"],
      "optionalByTopic": true
    },
    "build-room": {
      "required": ["FORGE", "AUDIT"],
      "optionalByTopic": true
    },
    "growth-room": {
      "required": ["PULSE"],
      "optionalByTopic": true
    },
    "tt-marketing-room": {
      "required": ["PULSE", "ANGLE", "AUDIT"],
      "optionalByTopic": false
    },
    "incubator-scan-room": {
      "required": ["PULSE", "ANGLE", "SCOUT", "COHORT", "VAULT"],
      "optionalByTopic": false
    },
    "incubator-synthesis-room": {
      "required": ["PULSE", "ANGLE", "SCOUT", "COHORT", "VAULT", "AUDIT"],
      "optionalByTopic": false
    },
    "mma-intake-room": {
      "required": ["FORGE", "CORNER", "SPOTTER", "TAPE"],
      "optionalByTopic": false
    },
    "mma-analysis-room": {
      "required": ["FORGE", "SIGMA", "VIG", "TAPE", "PIVOT", "AUDIT"],
      "optionalByTopic": false
    },
    "mag-editorial-room": {
      "required": ["CANVAS", "JAB", "QUILL", "AUDIT"],
      "optionalByTopic": false
    },
    "mag-desk-room": {
      "required": ["CANVAS", "JAB", "REACH", "PIVOT", "AUDIT"],
      "optionalByTopic": false
    },
    "evidence-room": {
      "required": ["VIZE", "SCOUT"],
      "optionalByTopic": true
    },
    "finance-room": {
      "required": ["LEDGER", "PULSE"],
      "optionalByTopic": true
    },
    "org-review": {
      "required": ["PEOPLE", "AUDIT", "KEEPER"],
      "includeAffectedAgent": true
    },
    "incident-room": {
      "required": ["AUDIT", "KEEPER", "FORGE"],
      "optionalByTopic": true
    }
  }
}
