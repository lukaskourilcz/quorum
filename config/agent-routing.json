      "status": "active"
    },
    "AUDIT": {
      "capabilities": ["audit", "quality", "risk"],
      "status": "active"
    },
    "SCOUT": {
      "capabilities": ["evidence", "sources"],
      "status": "active"
    },
    "SCRIBE": {
      "capabilities": ["summary", "public_projection"],
      "status": "active"
    },
    "LENS": {
      "capabilities": ["analytics", "forecast"],
      "status": "active"
    },
    "QUILL": {
      "capabilities": ["copy", "claims"],
      "status": "active"
    },
    "RADAR": {
      "capabilities": ["seo", "discoverability"],
      "status": "active"
    },
    "KEEPER": {
      "capabilities": ["compliance", "privacy", "permissions"],
      "status": "active"
    },
    "THREADS": {
      "capabilities": ["social:threads"],
      "status": "active"
    },
    "INSTAGRAM": {
