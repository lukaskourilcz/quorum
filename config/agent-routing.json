    "FUNNEL": {
      "capabilities": ["marketing:performance", "campaign:plan", "cost:estimate"],
      "status": "active"
    },
    "PALATE": {
      "capabilities": ["taste:memory", "ratings:distill", "visual:weights"],
      "status": "active"
    },
    "SCENE": {
      "capabilities": ["scene:research", "competition:evidence", "streetwear:signals"],
      "status": "active"
    },
    "STUNT": {
