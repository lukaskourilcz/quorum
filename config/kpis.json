{
  "meta": {
    "warmupCycles": 4,
    "retroEvery": 14,
    "windowCycles": 14,
    "warnBand": 0.2,
    "milestones": [
      {
        "id": "first_value_experiment",
        "byCycle": 8
      },
      {
        "id": "first_monetization_experiment",
        "byCycle": 14
      },
      {
        "id": "first_validation_decision",
        "byCycle": 14
      }
    ],
    "$comment": [
      "This file is an ownership record, not a measured KPI set. Seventy-odd of its entries carry",
      "measurement.kind = \"none\" with the reason nothing reads them, and that is the honest state:",
      "it says which agent answers for which outcome, and where a measurement does not exist yet.",
      "The measured quarterly set is config/kpis/2026-Q1.json, evaluated every morning into",
      "state/kpis/latest.json. Do not read a status out of this file; there is none to read."
    ]
  },
  "kpis": [
    {
      "id": "vize.opportunity_quality",
      "owner": "VIZE",
      "metric": "selectedOpportunityScore",
      "target": 35,
      "dir": "up",
      "stages": [
        "DISCOVERY",
        "VALIDATION"
      ],
      "measurement": {
        "kind": "none",
        "reason": "state/OPPORTUNITIES.json holds only fixture records (fixture: true, FIX-OPP-*). No opportunity has been selected, so there is no selected score to read."
      }
    },
    {
      "id": "vize.stage_progress",
