# Carousel previews are regenerable renders for looking at, not canonical state.
state/social/previews/

# The staged hook-library delivery is rebuilt from studio/hooks/ on every run and read back
# inside the same job. The receipt beside it is the canonical record of what was sent.
state/ventures/carousel-studio/hook-delivery.json

# The cached release-gate verdict for one commit; see .github/workflows/cycle.yml
.release-gate-verdict

# Provider responses held for the twenty-four hours Pixabay's terms require. Cache, not state:
# it keeps a re-run inside a day off the API, and it is worth nothing to anyone reading the repo.
state/cache/

# Door Money manuscript input is private source material and must never enter this public repo.
state/ventures/door-money/manuscript/
