{
  "name": "@boardlessai/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agents:validate": "node --import tsx src/validate-agents.ts",
    "bh:seed": "tsx src/ventures/booksofhistory/seed-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "budget:alert": "tsx src/finance/budget-alert-cli.ts",
    "book:ingest": "tsx src/ventures/door-money/ingest/cli.ts",
    "cycle": "node --import tsx src/index.ts",
    "cycle:phase": "tsx src/meetings/clock-cli.ts",
    "delivery": "tsx src/delivery/cli.ts",
    "release:verify": "tsx src/delivery/verifier-cli.ts",
    "digest:daily": "tsx src/notify/digest-cli.ts",
    "docs:refresh": "node --import tsx src/docs/ecosystem-cli.ts",
    "edition:dry": "tsx src/edition/dry-run.ts",
    "fightaiq:backfill": "tsx src/fightaiq/backfill-cli.ts",
    "fightaiq:events": "tsx src/fightaiq/events-cli.ts",
    "fightaiq:roster-sync": "tsx src/fightaiq/roster-sync-cli.ts",
    "ideas:migrate": "tsx src/ideas/migrate-cli.ts",
    "meetings:reconcile": "tsx src/meetings/reconcile-cli.ts",
    "mma:delivery": "tsx src/mma-files/publish-cli.ts",
    "queue:health": "tsx src/delivery/queue-health-cli.ts",
    "recall:image": "tsx src/mma-files/recall-image-cli.ts",
    "org:maintain": "tsx src/org/maintenance.ts",
    "operations:migrate": "tsx src/operations/migrate-cli.ts",
    "operations:release-audit": "node --import tsx src/operations/release-audit-cli.ts",
    "palate": "tsx src/taste/palate-cli.ts",
    "personal-growth:ingest": "tsx src/ventures/personal-growth/journal-cli.ts",
    "personal-growth:result": "tsx src/ventures/personal-growth/result-cli.ts",
    "proof:rooms": "tsx src/proof/portfolio-proof.ts",
    "programs:sync": "tsx src/programs/sync-cli.ts",
    "social:publish": "tsx src/social/index.ts",
    "sources:shadow": "tsx src/sources/shadow.ts",
    "pretest": "pnpm --filter @boardlessai/carousel-studio build",
    "pretypecheck": "pnpm --filter @boardlessai/carousel-studio build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "fightaiq:roster-prune": "tsx src/fightaiq/roster-prune-cli.ts",
    "social:deck": "tsx src/social/deck-cli.ts",
    "datasets:append": "tsx src/datasets/append-cli.ts",
    "streams:fetch": "tsx src/streams/fetch-cli.ts"
  },
  "dependencies": {
    "@boardlessai/carousel-studio": "workspace:*",
    "@anthropic-ai/sdk": "0.113.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "openai": "6.48.0",
    "rss-parser": "^3.13.0",
    "sharp": "0.35.3",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
